# Public application credentials used by the app client.
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_ANON_KEY=replace-with-test-anon-key

# Host-only credential used for trusted test cleanup and provisioning.
# Never pass this value to the Flutter application or a device.
SUPABASE_SERVICE_ROLE_KEY=app-service-rol-key

# Optional deterministic identifiers for CI diagnostics.
SUPABASE_TEST_PROJECT=local
SUPABASE_MIGRATION_VERSION=replace-with-current-migration-version
